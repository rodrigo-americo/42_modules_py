# .env.example - template de configuracao do oracle.py
#
# Copie este arquivo para .env e preencha com valores REAIS:
#     cp .env.example .env
#
# O .env (com valores reais) NAO vai para o git - so este .example.
# Nunca coloque segredos verdadeiros aqui.

# "development" ou "production". Ausente -> assume "development".
MATRIX_MODE=development

# String de conexao do banco. Obrigatoria em production.
DATABASE_URL=postgresql://user:password@localhost:5432/matrix

# Chave secreta de servicos externos. Obrigatoria em production.
API_KEY=replace-with-your-api-key

# Verbosidade de log. Ausente -> "INFO".
LOG_LEVEL=DEBUG

# URL da rede da resistencia. Ausente -> "http://localhost:9000".
ZION_ENDPOINT=http://localhost:9000
